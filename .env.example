# ─────────────────────────────────────────────────────────────
# Convoi Backend — Environment variables
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/convoi

# Secret used to secure session cookies (required, min 32 characters).
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=change-me-to-a-random-secret-of-at-least-32-chars

# Public base URL of the app (required). Used to build OAuth redirect URIs.
APP_URL=http://localhost:3000

# Google OAuth 2.0 credentials (required for Google sign-in).
# Create them at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_URL}/api/oauth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Optional — defaults apply when unset ─────────────────────

# Name of the session cookie (default: SESSION_COOKIE)
# SESSION_COOKIE_NAME=SESSION_COOKIE

# Session lifetime in milliseconds (default: 3600000 = 1 hour)
# SESSION_DURATION_MS=3600000

# bcrypt salt rounds (default: 10)
# SALT_ROUNDS=10

# Comma-separated list of allowed CORS origins (default: http://localhost:5173)
# CORS_ORIGINS=http://localhost:5173